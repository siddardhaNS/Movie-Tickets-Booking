# Leave DATABASE_URL unset to use the embedded PGlite database in ./.data (dev only).
# For real deployments (and the concurrency test) point it at Postgres 14+:
# DATABASE_URL=postgres://tickets:tickets@localhost:5432/tickets

# Secret used to sign login sessions. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Platform admin created by `npm run db:seed` (and by the dev auto-seed).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Optional: serve each theatre on its own subdomain, e.g. harishankar.tickets.example.com
# ROOT_DOMAIN=tickets.example.com
